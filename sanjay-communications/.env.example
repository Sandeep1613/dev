# ──────────────────────────────────────────────────────────
# Sanjay Communications — Environment Variables
# Copy this to .env.local and fill in real values.
# ──────────────────────────────────────────────────────────

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/sanjay_communications?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=change-this-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# JWT (used for OTP / mobile login tokens)
JWT_SECRET=another-long-random-string

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Twilio (for OTP via SMS) — optional; OTP falls back to console log if blank
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudinary (for product image uploads) — optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin credentials (auto-seeded on first run)
ADMIN_EMAIL=admin@sanjaycommunications.com
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Sanjay Admin
